{
  "name": "recon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:contracts": "hardhat test nodejs",
    "test:watch": "vitest --config vitest.config.ts",
    "contracts:compile": "hardhat compile",
    "demo:verify": "tsx scripts/verify-demo.ts",
    "demo:verify:forged": "tsx scripts/verify-demo.ts --forged",
    "probe:blocky402": "tsx scripts/probe-blocky402.ts",
    "probe:graph": "tsx scripts/probe-graph.ts",
    "probe:hedera": "tsx scripts/probe-hedera.ts",
    "web:build": "vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run contracts:compile && npm run web:build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@hiero-ledger/hiero-contracts": "^0.2.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "hardhat": "^3.16.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "viem": "^2.56.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
